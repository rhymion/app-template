// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Corresponding Prisma version: 7
// Corresponding JSON schema version: 2.0

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Common models
// ============================================================

// Tenant — deployment-level partition (one SaaS customer = one tenant).
// The broader design doc was removed as a planning doc in commit b11269b;
// recover it via `git show b11269b^:docs/multi-tenancy.md`. See also
// docs/knowledge/multi-tenancy-and-permissions.md for the current state.
//
// `creator_id` / `updater_id` are nullable because the bootstrap "default"
// tenant created by scripts/seed-its.ts and the 1.5 migration script
// exists before any user does. Normal admin-created tenants always
// carry both ids.
// exists before any user does. Normal admin-created tenants always
// carry both ids.
model tenant {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  // 'active' = sign-ins permitted; 'suspended' = sign-ins rejected by the
  // signIn callback (wired in ticket 1.4). Stored as a string for forward
  // compatibility with additional states ('archived', etc.).
  status     String   @default("active")
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String?
  creator    user?    @relation("TenantCreator", fields: [creator_id], references: [id])
  updater_id String?
  updater    user?    @relation("TenantUpdater", fields: [updater_id], references: [id])
  users      user[]   @relation("UserTenant")

  @@index([creator_id])
  @@index([updater_id])
}

model user {
  id                        String              @id @default(cuid())
  name                      String
  email                     String              @unique
  password                  String?
  api_key                   String?
  image                     String?
  emailVerified             DateTime?
  // 1.2: every user belongs to exactly one tenant. The `@default("default")`
  // matches the bootstrap tenant id seeded by scripts/seed-its.ts and the
  // 1.5 backfill migration, so write paths that pre-date the generator
  // updates in Phase 3 keep working until they thread `tenant_id` through
  // explicitly. onDelete: Restrict — accidental tenant deletion must not
  // cascade to users.
  tenant_id                 String              @default("default")
  tenant                    tenant              @relation("UserTenant", fields: [tenant_id], references: [id], onDelete: Restrict)
  reactions                 reaction[]          @relation("ReactionUser")
  // MFA / TOTP (S5). `mfa_secret` is AES-256-GCM ciphertext produced by
  // lib/mfa/crypto.ts; `mfa_enabled` only flips true after a successful
  // first-code verification. `mfa_recovery_codes` is the back-relation
  // for the single-use codes.
  mfa_secret                String?
  mfa_enabled               Boolean             @default(false)
  mfa_recovery_codes        mfa_recovery_code[]
  // Bumped whenever MFA is enabled (lib/mfa/enrollment.ts completeEnrollment).
  // auth.ts's jwt() callback snapshots this into the JWT at sign-in and
  // re-compares it on every subsequent request; a mismatch re-arms
  // mfa_pending so an already-active session can't outlive a later MFA
  // enable for up to JWT_MAX_AGE (cmd_527, docs/knowledge/authentication.md).
  mfa_token_version          Int                 @default(0)
  accounts                  Account[]
  sessions                  Session[]
  created_at                DateTime            @default(now()) @db.Timestamptz(0)
  updated_at                DateTime            @updatedAt @db.Timestamptz(0)
  creator_id                String
  creator                   user                @relation("UserCreator", fields: [creator_id], references: [id])
  updater_id                String
  updater                   user                @relation("UserUpdater", fields: [updater_id], references: [id])
  roles                     role[]              @relation("UserRoles")
  organizations             organization[]      @relation("UserOrganizations")
  created_permissions       permission[]        @relation("PermissionCreator")
  updated_permissions       permission[]        @relation("PermissionUpdater")
  created_roles             role[]              @relation("RoleCreator")
  updated_roles             role[]              @relation("RoleUpdater")
  created_organizations     organization[]      @relation("OrganizationCreator")
  updated_organizations     organization[]      @relation("OrganizationUpdater")
  created_users             user[]              @relation("UserCreator")
  updated_users             user[]              @relation("UserUpdater")
  created_comments          comment[]           @relation("CommentCreator")
  created_approval_flows    approval_flow[]     @relation("ApprovalFlowCreator")
  updated_approval_flows    approval_flow[]     @relation("ApprovalFlowUpdater")
  created_approval_historys approval_history[]  @relation("ApprovalHistoryCreator")
  created_approvables       approvable[]        @relation("ApprovableCreator")
  created_dashboards        dashboard[]         @relation("DashboardCreator")
  updated_dashboards        dashboard[]         @relation("DashboardUpdater")
  created_tenants           tenant[]            @relation("TenantCreator")
  updated_tenants           tenant[]            @relation("TenantUpdater")
  audit_logs                audit_log[]
  notifications             notification[]      @relation("NotificationUser")
  anonymized_at             DateTime?            // Timestamp when PII was scrubbed (GDPR anonymization)
  // cmd_564/cmd_569: generic invalidate mechanism co-set — anonymize_user.ts
  // now unconditionally sets this alongside anonymized_at for any entity
  // using the anonymizeUser handler (pre-existing x-generate.invalidate on
  // `user`, not new from this cmd's own location opt-in).
  invalidated_at             DateTime?

  // Inventory management (see "Inventory management models" at the end of this file)
  created_unit_of_measures       unit_of_measure[]       @relation("UnitOfMeasureCreator")
  updated_unit_of_measures       unit_of_measure[]       @relation("UnitOfMeasureUpdater")
  created_items                  item[]                  @relation("ItemCreator")
  updated_items                  item[]                  @relation("ItemUpdater")
  created_locations              location[]              @relation("LocationCreator")
  updated_locations              location[]              @relation("LocationUpdater")
  created_bins                   bin[]                   @relation("BinCreator")
  updated_bins                   bin[]                   @relation("BinUpdater")
  created_suppliers              supplier[]              @relation("SupplierCreator")
  updated_suppliers              supplier[]              @relation("SupplierUpdater")
  created_purchase_orders        purchase_order[]        @relation("PurchaseOrderCreator")
  updated_purchase_orders        purchase_order[]        @relation("PurchaseOrderUpdater")
  created_purchase_order_lines   purchase_order_line[]   @relation("PurchaseOrderLineCreator")
  updated_purchase_order_lines   purchase_order_line[]   @relation("PurchaseOrderLineUpdater")
  created_asns                   asn[]                   @relation("AsnCreator")
  updated_asns                   asn[]                   @relation("AsnUpdater")
  created_asn_lines              asn_line[]              @relation("AsnLineCreator")
  updated_asn_lines              asn_line[]              @relation("AsnLineUpdater")
  created_goods_receipts         goods_receipt[]         @relation("GoodsReceiptCreator")
  updated_goods_receipts         goods_receipt[]         @relation("GoodsReceiptUpdater")
  created_goods_receipt_lines    goods_receipt_line[]    @relation("GoodsReceiptLineCreator")
  updated_goods_receipt_lines    goods_receipt_line[]    @relation("GoodsReceiptLineUpdater")
  created_inventories            inventory[]             @relation("InventoryCreator")
  updated_inventories            inventory[]             @relation("InventoryUpdater")
  created_inventory_transactions inventory_transaction[] @relation("InventoryTransactionCreator")
  updated_inventory_transactions inventory_transaction[] @relation("InventoryTransactionUpdater")
  // inventory_transaction.created_by_id — the actor the ledger write is
  // attributed to (set by the generated afterApprove ledger write).
  ledger_writes                  inventory_transaction[] @relation("InventoryTransactionCreatedBy")

  @@index([api_key])
  @@index([creator_id])
  @@index([tenant_id])
  @@index([updater_id])
}

model role {
  id          String  @id @default(cuid())
  name        String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user @relation("RoleCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user @relation("RoleUpdater", fields: [updater_id], references: [id])

  users user[] @relation("UserRoles")
  permissions   permission[]
  requestor_approval_flows approval_flow[] @relation("ApprovalFlowRequestorRole")
  approver_approval_flows  approval_flow[] @relation("ApprovalFlowApproverRole")
  @@index([creator_id])
  @@index([updater_id])
}

model organization {
  id          String  @id @default(cuid())
  name        String
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user @relation("OrganizationCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user       @relation("OrganizationUpdater", fields: [updater_id], references: [id])
  users       user[]     @relation("UserOrganizations")
  @@index([creator_id])
  @@index([updater_id])
}

model permission {
  id         String  @id @default(cuid())
  name       String
  role_id    String?
  role       role?   @relation(fields: [role_id], references: [id], onDelete: Cascade)
  create     Boolean
  read       Boolean
  update     Boolean
  delete     Boolean
  import     Boolean @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user @relation("PermissionCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user @relation("PermissionUpdater", fields: [updater_id], references: [id])

  @@unique([name, role_id])
  @@index([creator_id])
  @@index([role_id])
  @@index([updater_id])
}

model approvable {
  id               String   @id @default(cuid())
  creator_id       String?
  creator          user? @relation("ApprovableCreator", fields: [creator_id], references: [id])
  approval_requests approval_request[]
  approved_at       DateTime?          @db.Timestamptz(0)
  rejection_reason  String?
  // Owner back-relations (one per entity carrying a one-to-one_bridge FK to
  // approvable). Required by Prisma: a one-to-one relation needs both sides.
  goods_receipt_line goods_receipt_line?

  @@index([creator_id])
}

model approval_flow {
  id               String   @id @default(cuid())
  entity_name      String
  requestor_role_id String?
  requestor_role   role?    @relation("ApprovalFlowRequestorRole", fields: [requestor_role_id], references: [id])
  approver_role_id String
  approver_role    role     @relation("ApprovalFlowApproverRole", fields: [approver_role_id], references: [id])
  approval_requests approval_request[]
  preceded_by      approval_flow[] @relation("ApprovalFlowOrder")
  followed_by      approval_flow[] @relation("ApprovalFlowOrder")
  created_at       DateTime @default(now()) @db.Timestamptz(0)
  updated_at       DateTime @updatedAt @db.Timestamptz(0)
  creator_id       String
  creator          user @relation("ApprovalFlowCreator", fields: [creator_id], references: [id])
  updater_id       String
  updater          user @relation("ApprovalFlowUpdater", fields: [updater_id], references: [id])
  @@index([creator_id])
  @@index([approver_role_id])
  @@index([requestor_role_id])
  @@index([updater_id])
}

enum ApprovalRequestStatus {
  pending
  approved
  rejected
  terminal_rejected
}

model approval_request {
  id               String   @id @default(cuid())
  approvable_id    String
  approvable       approvable @relation(fields: [approvable_id], references: [id], onDelete: Cascade)
  approval_flow_id String
  approval_flow    approval_flow @relation(fields: [approval_flow_id], references: [id])
  status           ApprovalRequestStatus @default(pending)
  approval_histories approval_history[]
  created_at       DateTime @default(now()) @db.Timestamptz(0)
  updated_at       DateTime @updatedAt @db.Timestamptz(0)
  @@index([approvable_id])
  @@index([approval_flow_id])
}

model approval_history {
  id               String   @id @default(cuid())
  approval_request_id String
  approval_request approval_request @relation(fields: [approval_request_id], references: [id], onDelete: Cascade)
  pre_status       Int
  post_status      Int
  message          String?
  reason_kind      Int?             // 0=Customer 1=Internal
  created_at       DateTime @default(now()) @db.Timestamptz(0)
  updated_at       DateTime @updatedAt @db.Timestamptz(0)
  creator_id       String
  creator          user @relation("ApprovalHistoryCreator", fields: [creator_id], references: [id])
  @@index([creator_id])
  @@index([approval_request_id])
}

model commentable {
  id        String    @id @default(cuid())
  comments  comment[]
}

model comment {
  id             String      @id @default(cuid())
  message        String
  commentable_id String
  commentable    commentable @relation(fields: [commentable_id], references: [id], onDelete: Cascade)
  reactions      reaction[]
  created_at     DateTime    @default(now()) @db.Timestamptz(0)
  updated_at     DateTime    @updatedAt @db.Timestamptz(0)
  creator_id     String
  creator        user @relation("CommentCreator", fields: [creator_id], references: [id])
  @@index([creator_id])
  @@index([commentable_id])
}

enum ReactionType {
  like
  love
  laugh
  surprised
  sad
}

model reaction {
  id          String       @id @default(cuid())
  type        ReactionType
  user_id     String
  user        user         @relation("ReactionUser", fields: [user_id], references: [id])
  comment_id  String
  comment     comment      @relation(fields: [comment_id], references: [id], onDelete: Cascade)
  created_at  DateTime     @default(now()) @db.Timestamptz(0)
  updated_at  DateTime     @updatedAt @db.Timestamptz(0)

  @@unique([comment_id, user_id, type])
  @@index([user_id])
  @@index([comment_id])
}

model attachable {
  id          String       @id @default(cuid())
  attachments attachment[]
}

enum AttachmentType {
  image
  file
  video
  audio
}

model attachment {
  id                     String         @id @default(cuid())
  type                   AttachmentType @default(image)
  order                  Int            @default(0)
  name                   String
  path                   String
  encrypted_original_name String?
  name_iv                String?
  attachable_id          String
  attachable             attachable @relation(fields: [attachable_id], references: [id], onDelete: Cascade)
  created_at             DateTime   @default(now()) @db.Timestamptz(0)
  updated_at             DateTime   @updatedAt @db.Timestamptz(0)
  @@index([attachable_id])
}

model dashboard {
  id         String             @id @default(cuid())
  name       String
  widgets    dashboard_widget[]
  created_at DateTime           @default(now()) @db.Timestamptz(0)
  updated_at DateTime           @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user               @relation("DashboardCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user               @relation("DashboardUpdater", fields: [updater_id], references: [id])

  @@index([creator_id])
  @@index([updater_id])
}

enum DashboardWidgetChartType {
  pie
  column
  bar
  line
}

enum DashboardWidgetStackMode {
  grouped
  stacked
  standardized
}

enum DashboardWidgetGroupByBucket {
  day
  week
  month
  quarter
  year
}

model dashboard_widget {
  id             String    @id @default(cuid())
  dashboard_id   String
  dashboard      dashboard @relation(fields: [dashboard_id], references: [id], onDelete: Cascade)
  name            String
  entity_name     String
  chart_type      DashboardWidgetChartType @default(column)
  group_by_field  String
  stack_mode      DashboardWidgetStackMode?
  series_field    String?
  group_by_bucket DashboardWidgetGroupByBucket?
  filter_field    String?
  filter_value    String?
  order          Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(0)
  updated_at     DateTime  @updatedAt @db.Timestamptz(0)
  @@index([dashboard_id])
}

// Per-user notification store (framework default, mirrored from
// code_generator/json_schema_internal.yaml). Primary store for the polling
// bell UI / app/api/notifications/* routes — no CRUD UI/API is generated
// for this entity (lib/_notifier.ts writes rows directly via Prisma,
// fire-and-forget). Immutable event log aside from the `read` flag, so
// there is no updated_at/creator tracking.
model notification {
  id         String   @id @default(cuid())
  user_id    String
  user       user     @relation("NotificationUser", fields: [user_id], references: [id], onDelete: Cascade)
  type       String
  payload    Json
  read       Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(0)

  @@index([user_id, read])
  @@index([user_id, created_at(sort: Desc)])
}

// Append-only audit trail for security-relevant events: auth lifecycle
// (sign-in/out, account creation, sign-in rejection) and CRUD on protected
// entities (roles, permissions, role assignments, …). Rows must outlive the
// user they reference, so `actor_user_id` is a plain string with no FK
// constraint — deleting a user does not cascade-delete their audit history.
// `actor_user_id` is nullable because some events (rejected sign-in with an
// unknown email, system-triggered actions) have no resolved actor.
model audit_log {
  id            String   @id @default(cuid())
  actor_user_id String?
  actor_user    user?    @relation(fields: [actor_user_id], references: [id], onDelete: Restrict)
  action        String
  target_table  String?
  target_id     String?
  metadata      Json?
  created_at    DateTime @default(now()) @db.Timestamptz(0)

  @@index([actor_user_id])
  @@index([target_table, target_id])
  @@index([created_at])
}

// Single-use MFA recovery codes (S5). One row per generated code.
// `code_hash` is bcrypt of the *normalized* plaintext (uppercased, dashes
// stripped) so verification doesn't have to guess at the user's
// punctuation habits. `used_at` is set on first successful verification
// and the row is then dead weight — kept around so a future "MFA audit
// log" page can show "X recovery codes used" without joining elsewhere.
model mfa_recovery_code {
  id         String    @id @default(cuid())
  user_id    String
  user       user      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  code_hash  String
  used_at    DateTime? @db.Timestamptz(0)
  created_at DateTime  @default(now()) @db.Timestamptz(0)

  @@index([user_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// NextAuth (@next-auth/prisma-adapter) auxiliary tables.
//
// `Account`, `Session`, `VerificationToken` are PascalCase by NextAuth
// contract — the adapter accesses them as `prisma.account`, `prisma.session`,
// `prisma.verificationToken`, which the Prisma client derives by
// lower-casing the first letter of the model name.
//
// The `User` model required by PrismaAdapter is *the same row* as our
// domain `user` (see `model user` above) — `prisma.user` resolves to that
// model since Prisma lower-cases the model name. The adapter writes
// `emailVerified` / `image` directly into the merged table; the
// `user_account ↔ User` mirror that existed in earlier versions is gone.
//
// `session: { strategy: 'jwt' }` is kept in auth.ts so the Credentials
// provider keeps working:
//   - `Account` rows are written on every OAuth sign-in (identity stability
//     by providerAccountId).
//   - `Session` is unused today; lights up under Auth.js v5 (database
//     sessions).
//   - `VerificationToken` is unused until an Email/magic-link provider is
//     added.
// ─────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
// ============================================================
// Inventory management models (procure-to-receive)
// ============================================================
// Derived from prj/spec/inventory-er-diagram.mermaid, then wired into the
// generator's ledger primitives (x-ledger-entities / x-ledger-source /
// x-splittable / x-approval — see
// docs/knowledge/appendix/inventory-domain-generalization-design.md and
// appendix/inventory-reservation-split.md).
//
// Deviations from the ER diagram, and why:
//
//  1. `decimal` -> `Int`.  code_generator/schema_deriver.py's `_SCALAR_JSON_TYPE`
//     supports only String / Boolean / Int / DateTime / native enums; a
//     `Decimal` column aborts generate-code with SchemaDivergenceError.
//     Quantities are whole stock-keeping units; `unit_price` is stored in
//     minor currency units (e.g. cents), not major units.
//
//  2. The diagram's `createdById` / `receivedById` / `recordedById` all map onto
//     the framework's built-in `creator_id` audit column, and `recordedAt` onto
//     `created_at`, instead of second FKs to `user`.
//
//  3. The diagram has no stock-on-hand table — it models only documents and a
//     movement log.  `inventory` (the ledger *pool*) and `inventory_transactionable`
//     (the ledger *bridge*) are added here because the generator's ledger
//     primitives require a pool/ledger/transactionable triple; see the
//     x-ledger-entities block in json_schema.yaml.
//
//  4. `inventory_transaction`'s column vocabulary (`event_type`,
//     `quantity_delta`, `reserved_delta`, `product_id`, `location`,
//     `lot_number`, `expiration_date`, `approved_via`, `created_by_id`) and
//     `inventory`'s (`product_id`, `location_id`, `lot_number`,
//     `expiration_date`, `quantity`, `reserved_quantity`) are fixed by
//     code_generator/templates/ledger_write_stub.ts.jinja2, which writes those
//     names literally.  `product_id` therefore points at `item` — the diagram's
//     name for the catalog entity — via a relation field named `product`.
//
// nativeEnum members are lowercase snake_case, enforced by validate.py
// (docs/knowledge/enum-member-naming.md).

enum LocationType {
  warehouse
  store
  distribution_center
  supplier_site
}

enum BinZone {
  receiving
  storage
  picking
  quarantine
  shipping
}

enum PurchaseOrderStatus {
  draft
  approved
  sent
  acknowledged
  partially_received
  closed
  cancelled
}

enum PurchaseOrderLineStatus {
  open
  partially_received
  fulfilled
  cancelled
}

enum AsnStatus {
  pending
  shipped
  in_transit
  arrived
  received
  cancelled
}

enum GoodsReceiptStatus {
  draft
  posted
  completed
  cancelled
}

// `pending`, `split` and `rejected` are required members:
// split_action_route.ts.jinja2 compares the row's status against SPLIT_STATUS /
// REJECTED_STATUS and creates every split child with `status: 'pending'`.
enum GoodsReceiptLineStatus {
  pending
  received
  inspecting
  accepted
  rejected
  put_away
  split
}

// Ledger event vocabulary. `receive` is written by goods_receipt_line's
// x-ledger-source; the rest are available to hand-written ledger writes.
enum InventoryEventType {
  receive
  ship
  reserve
  release
  adjust
  move
  write_off
  return_to_supplier
}

model unit_of_measure {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("UnitOfMeasureCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("UnitOfMeasureUpdater", fields: [updater_id], references: [id])

  items                item[]                @relation("ItemUnitOfMeasure")
  purchase_order_lines purchase_order_line[] @relation("PurchaseOrderLineUnitOfMeasure")
  asn_lines            asn_line[]            @relation("AsnLineUnitOfMeasure")
  goods_receipt_lines  goods_receipt_line[]  @relation("GoodsReceiptLineUnitOfMeasure")

  @@index([creator_id])
  @@index([updater_id])
}

model item {
  id                 String          @id @default(cuid())
  sku                String          @unique
  name               String
  description        String?
  unit_of_measure_id String
  unit_of_measure    unit_of_measure @relation("ItemUnitOfMeasure", fields: [unit_of_measure_id], references: [id], onDelete: Restrict)
  is_lot_tracked     Boolean         @default(false)
  is_serial_tracked  Boolean         @default(false)
  shelf_life_days    Int?
  created_at         DateTime        @default(now()) @db.Timestamptz(0)
  updated_at         DateTime        @updatedAt @db.Timestamptz(0)
  creator_id         String
  creator            user            @relation("ItemCreator", fields: [creator_id], references: [id])
  updater_id         String
  updater            user            @relation("ItemUpdater", fields: [updater_id], references: [id])

  purchase_order_lines   purchase_order_line[]   @relation("PurchaseOrderLineItem")
  asn_lines              asn_line[]              @relation("AsnLineItem")
  goods_receipt_lines    goods_receipt_line[]    @relation("GoodsReceiptLineItem")
  inventories            inventory[]             @relation("InventoryProduct")
  inventory_transactions inventory_transaction[] @relation("InventoryTransactionProduct")

  @@index([creator_id])
  @@index([updater_id])
  @@index([unit_of_measure_id])
}

model location {
  id             String       @id @default(cuid())
  code           String       @unique
  name           String
  type           LocationType @default(warehouse)
  invalidated_at DateTime?
  created_at     DateTime     @default(now()) @db.Timestamptz(0)
  updated_at DateTime     @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user         @relation("LocationCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user         @relation("LocationUpdater", fields: [updater_id], references: [id])

  bins                   bin[]                   @relation("BinLocation")
  goods_receipts         goods_receipt[]         @relation("GoodsReceiptLocation")
  inventories            inventory[]             @relation("InventoryLocation")
  inventory_transactions inventory_transaction[] @relation("InventoryTransactionLocation")

  @@index([creator_id])
  @@index([updater_id])
}

model bin {
  id          String   @id @default(cuid())
  location_id String
  location    location @relation("BinLocation", fields: [location_id], references: [id], onDelete: Cascade)
  code        String
  zone        BinZone  @default(storage)
  created_at  DateTime @default(now()) @db.Timestamptz(0)
  updated_at  DateTime @updatedAt @db.Timestamptz(0)
  creator_id  String
  creator     user     @relation("BinCreator", fields: [creator_id], references: [id])
  updater_id  String
  updater     user     @relation("BinUpdater", fields: [updater_id], references: [id])

  goods_receipt_lines    goods_receipt_line[]    @relation("GoodsReceiptLineDestinationBin")
  inventory_transactions inventory_transaction[] @relation("InventoryTransactionBin")

  @@unique([location_id, code])
  @@index([creator_id])
  @@index([updater_id])
  @@index([location_id])
}

model supplier {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(0)
  updated_at DateTime @updatedAt @db.Timestamptz(0)
  creator_id String
  creator    user     @relation("SupplierCreator", fields: [creator_id], references: [id])
  updater_id String
  updater    user     @relation("SupplierUpdater", fields: [updater_id], references: [id])

  purchase_orders purchase_order[] @relation("PurchaseOrderSupplier")
  asns            asn[]            @relation("AsnSupplier")
  goods_receipts  goods_receipt[]  @relation("GoodsReceiptSupplier")

  @@index([creator_id])
  @@index([updater_id])
}

model purchase_order {
  id                      String              @id @default(cuid())
  po_number               String              @unique
  supplier_id             String
  supplier                supplier            @relation("PurchaseOrderSupplier", fields: [supplier_id], references: [id], onDelete: Restrict)
  status                  PurchaseOrderStatus @default(draft)
  requested_delivery_date DateTime?           @db.Date
  confirmed_delivery_date DateTime?           @db.Date
  currency                String              @default("USD")
  created_at              DateTime            @default(now()) @db.Timestamptz(0)
  updated_at              DateTime            @updatedAt @db.Timestamptz(0)
  creator_id              String
  creator                 user                @relation("PurchaseOrderCreator", fields: [creator_id], references: [id])
  updater_id              String
  updater                 user                @relation("PurchaseOrderUpdater", fields: [updater_id], references: [id])

  purchase_order_lines purchase_order_line[] @relation("PurchaseOrderLinePurchaseOrder")

  @@index([creator_id])
  @@index([updater_id])
  @@index([supplier_id])
}

model purchase_order_line {
  id                      String                  @id @default(cuid())
  purchase_order_id       String
  purchase_order          purchase_order          @relation("PurchaseOrderLinePurchaseOrder", fields: [purchase_order_id], references: [id], onDelete: Cascade)
  item_id                 String
  item                    item                    @relation("PurchaseOrderLineItem", fields: [item_id], references: [id], onDelete: Restrict)
  quantity_ordered        Int
  unit_of_measure_id      String
  unit_of_measure         unit_of_measure         @relation("PurchaseOrderLineUnitOfMeasure", fields: [unit_of_measure_id], references: [id], onDelete: Restrict)
  // Minor currency units (e.g. cents) — see the Decimal note at the top of this section.
  unit_price              Int
  requested_delivery_date DateTime?               @db.Date
  status                  PurchaseOrderLineStatus @default(open)
  created_at              DateTime                @default(now()) @db.Timestamptz(0)
  updated_at              DateTime                @updatedAt @db.Timestamptz(0)
  creator_id              String
  creator                 user                    @relation("PurchaseOrderLineCreator", fields: [creator_id], references: [id])
  updater_id              String
  updater                 user                    @relation("PurchaseOrderLineUpdater", fields: [updater_id], references: [id])

  asn_lines           asn_line[]           @relation("AsnLinePurchaseOrderLine")
  goods_receipt_lines goods_receipt_line[] @relation("GoodsReceiptLinePurchaseOrderLine")

  @@unique([purchase_order_id, item_id])
  @@index([creator_id])
  @@index([updater_id])
  @@index([purchase_order_id])
  @@index([item_id])
  @@index([unit_of_measure_id])
}

model asn {
  id                  String    @id @default(cuid())
  asn_number          String    @unique
  supplier_id         String
  supplier            supplier  @relation("AsnSupplier", fields: [supplier_id], references: [id], onDelete: Restrict)
  carrier             String?
  tracking_number     String?
  shipped_at          DateTime? @db.Timestamptz(0)
  expected_arrival_at DateTime? @db.Timestamptz(0)
  status              AsnStatus @default(pending)
  created_at          DateTime  @default(now()) @db.Timestamptz(0)
  updated_at          DateTime  @updatedAt @db.Timestamptz(0)
  creator_id          String
  creator             user      @relation("AsnCreator", fields: [creator_id], references: [id])
  updater_id          String
  updater             user      @relation("AsnUpdater", fields: [updater_id], references: [id])

  asn_lines asn_line[] @relation("AsnLineAsn")

  @@index([creator_id])
  @@index([updater_id])
  @@index([supplier_id])
}

model asn_line {
  id                     String              @id @default(cuid())
  asn_id                 String
  asn                    asn                 @relation("AsnLineAsn", fields: [asn_id], references: [id], onDelete: Cascade)
  purchase_order_line_id String
  purchase_order_line    purchase_order_line @relation("AsnLinePurchaseOrderLine", fields: [purchase_order_line_id], references: [id], onDelete: Restrict)
  item_id                String
  item                   item                @relation("AsnLineItem", fields: [item_id], references: [id], onDelete: Restrict)
  quantity_shipped       Int
  unit_of_measure_id     String
  unit_of_measure        unit_of_measure     @relation("AsnLineUnitOfMeasure", fields: [unit_of_measure_id], references: [id], onDelete: Restrict)
  lot_number             String?
  expiry_date            DateTime?           @db.Date
  created_at             DateTime            @default(now()) @db.Timestamptz(0)
  updated_at             DateTime            @updatedAt @db.Timestamptz(0)
  creator_id             String
  creator                user                @relation("AsnLineCreator", fields: [creator_id], references: [id])
  updater_id             String
  updater                user                @relation("AsnLineUpdater", fields: [updater_id], references: [id])

  goods_receipt_lines goods_receipt_line[] @relation("GoodsReceiptLineAsnLine")

  @@unique([asn_id, item_id])
  @@index([creator_id])
  @@index([updater_id])
  @@index([asn_id])
  @@index([purchase_order_line_id])
  @@index([item_id])
  @@index([unit_of_measure_id])
}

model goods_receipt {
  id             String             @id @default(cuid())
  receipt_number String             @unique
  supplier_id    String
  supplier       supplier           @relation("GoodsReceiptSupplier", fields: [supplier_id], references: [id], onDelete: Restrict)
  location_id    String
  location       location           @relation("GoodsReceiptLocation", fields: [location_id], references: [id], onDelete: Restrict)
  received_at    DateTime           @db.Timestamptz(0)
  status         GoodsReceiptStatus @default(draft)
  notes          String?
  created_at     DateTime           @default(now()) @db.Timestamptz(0)
  updated_at     DateTime           @updatedAt @db.Timestamptz(0)
  creator_id     String
  creator        user               @relation("GoodsReceiptCreator", fields: [creator_id], references: [id])
  updater_id     String
  updater        user               @relation("GoodsReceiptUpdater", fields: [updater_id], references: [id])

  goods_receipt_lines goods_receipt_line[] @relation("GoodsReceiptLineGoodsReceipt")

  @@index([creator_id])
  @@index([updater_id])
  @@index([supplier_id])
  @@index([location_id])
}

// The receiving line is the ledger source: approving it writes the `receive`
// row into inventory_transaction and increments the inventory pool
// (x-ledger-source + x-approval.on_approved.emit_hook).  It is also
// x-splittable, so one received line can be divided across several lots/bins,
// each split part carrying its own approvable and its own ledger bridge.
model goods_receipt_line {
  id                           String                     @id @default(cuid())
  goods_receipt_id             String
  goods_receipt                goods_receipt              @relation("GoodsReceiptLineGoodsReceipt", fields: [goods_receipt_id], references: [id], onDelete: Cascade)
  purchase_order_line_id       String?
  purchase_order_line          purchase_order_line?       @relation("GoodsReceiptLinePurchaseOrderLine", fields: [purchase_order_line_id], references: [id], onDelete: SetNull)
  asn_line_id                  String?
  asn_line                     asn_line?                  @relation("GoodsReceiptLineAsnLine", fields: [asn_line_id], references: [id], onDelete: SetNull)
  item_id                      String
  item                         item                       @relation("GoodsReceiptLineItem", fields: [item_id], references: [id], onDelete: Restrict)
  quantity_received            Int
  unit_of_measure_id           String
  unit_of_measure              unit_of_measure            @relation("GoodsReceiptLineUnitOfMeasure", fields: [unit_of_measure_id], references: [id], onDelete: Restrict)
  lot_number                   String?
  expiry_date                  DateTime?                  @db.Date
  destination_bin_id           String?
  destination_bin              bin?                       @relation("GoodsReceiptLineDestinationBin", fields: [destination_bin_id], references: [id], onDelete: SetNull)
  status                       GoodsReceiptLineStatus     @default(pending)
  discrepancy_reason           String?
  // x-ledger-source.poolIdField — which stock lot this line lands in. Nullable:
  // the lot is chosen at receiving/split time, not at line creation.
  inventory_id                 String?
  inventory                    inventory?                 @relation("GoodsReceiptLineInventory", fields: [inventory_id], references: [id], onDelete: SetNull)
  // x-splittable.bridgeField — per-row ledger bridge; each split part gets its own.
  inventory_transactionable_id String?
  inventory_transactionable    inventory_transactionable? @relation(fields: [inventory_transactionable_id], references: [id], onDelete: SetNull)
  // Approval bridge (mandatory per cmd_296: never nulled, never deleted).
  approvable_id                String                     @unique
  approvable                   approvable                 @relation(fields: [approvable_id], references: [id])
  // x-splittable.parentField — self-referential split lineage.
  parent_goods_receipt_line_id String?
  parent_goods_receipt_line    goods_receipt_line?        @relation("GoodsReceiptLineSplit", fields: [parent_goods_receipt_line_id], references: [id], onDelete: SetNull)
  split_goods_receipt_lines    goods_receipt_line[]       @relation("GoodsReceiptLineSplit")
  created_at                   DateTime                   @default(now()) @db.Timestamptz(0)
  updated_at                   DateTime                   @updatedAt @db.Timestamptz(0)
  // Nullable, unlike every other model here: split_action_route.ts.jinja2
  // creates split children without writing creator_id/updater_id, so a
  // non-nullable column fails the generated create at type-check time.
  creator_id                   String?
  creator                      user?                      @relation("GoodsReceiptLineCreator", fields: [creator_id], references: [id])
  updater_id                   String?
  updater                      user?                      @relation("GoodsReceiptLineUpdater", fields: [updater_id], references: [id])

  @@index([creator_id])
  @@index([updater_id])
  @@index([goods_receipt_id])
  @@index([purchase_order_line_id])
  @@index([asn_line_id])
  @@index([item_id])
  @@index([unit_of_measure_id])
  @@index([destination_bin_id])
  @@index([inventory_id])
  @@index([inventory_transactionable_id])
  @@index([parent_goods_receipt_line_id])
}

// ---- Ledger domain: pool / ledger / transactionable -------------------------
// Declared as an aggregate under x-ledger-entities.inventory_domain in
// json_schema.yaml. Column names below are the vocabulary
// ledger_write_stub.ts.jinja2 writes literally — do not rename them.

// Pool: materialized stock-on-hand per (product, location, lot, expiry).
model inventory {
  id                String    @id @default(cuid())
  product_id        String
  product           item      @relation("InventoryProduct", fields: [product_id], references: [id], onDelete: Restrict)
  location_id       String?
  location          location? @relation("InventoryLocation", fields: [location_id], references: [id], onDelete: SetNull)
  lot_number        String?
  expiration_date   DateTime? @db.Date
  quantity          Int       @default(0)
  reserved_quantity Int       @default(0)
  created_at        DateTime  @default(now()) @db.Timestamptz(0)
  updated_at        DateTime  @updatedAt @db.Timestamptz(0)
  creator_id        String
  creator           user      @relation("InventoryCreator", fields: [creator_id], references: [id])
  updater_id        String
  updater           user      @relation("InventoryUpdater", fields: [updater_id], references: [id])

  goods_receipt_lines goods_receipt_line[] @relation("GoodsReceiptLineInventory")

  @@unique([product_id, location_id, lot_number, expiration_date])
  @@index([creator_id])
  @@index([updater_id])
  @@index([product_id])
  @@index([location_id])
}

// Transactionable: internal one-to-many bridge tying a source row (a
// goods_receipt_line, or a split part of one) to the ledger rows it produced.
// No pages, no API — the generator manages it.
model inventory_transactionable {
  id                     String                  @id @default(cuid())
  inventory_transactions inventory_transaction[]
  goods_receipt_lines    goods_receipt_line[]
}

// Ledger: append-oriented movement log. `quantity_delta` moves physical stock,
// `reserved_delta` moves the reservation counter; `product_id` / `location` /
// `lot_number` / `expiration_date` are the O-6 denormalized pool identity.
model inventory_transaction {
  id                           String                     @id @default(cuid())
  inventory_transactionable_id String?
  inventory_transactionable    inventory_transactionable? @relation(fields: [inventory_transactionable_id], references: [id], onDelete: SetNull)
  event_type                   InventoryEventType
  quantity_delta               Int                        @default(0)
  reserved_delta               Int                        @default(0)
  product_id                   String
  product                      item                       @relation("InventoryTransactionProduct", fields: [product_id], references: [id], onDelete: Restrict)
  location_id                  String?
  location                     location?                  @relation("InventoryTransactionLocation", fields: [location_id], references: [id], onDelete: Restrict)
  lot_number                   String?
  expiration_date              DateTime?                  @db.Date
  // approval_request/approvable id this write was authorized by (R2 audit trail).
  approved_via                 String?
  created_by_id                String
  created_by                   user                       @relation("InventoryTransactionCreatedBy", fields: [created_by_id], references: [id])
  bin_id                       String?
  bin                          bin?                       @relation("InventoryTransactionBin", fields: [bin_id], references: [id], onDelete: SetNull)
  reason                       String?
  serial_number                String?
  // Free-form source reference for movements originating outside the
  // receiving flow (issues, adjustments, write-offs, returns).
  source_document_type         String?
  source_document_ref          String?
  occurred_at                  DateTime                   @default(now()) @db.Timestamptz(0)
  created_at                   DateTime                   @default(now()) @db.Timestamptz(0)
  updated_at                   DateTime                   @updatedAt @db.Timestamptz(0)
  creator_id                   String
  creator                      user                       @relation("InventoryTransactionCreator", fields: [creator_id], references: [id])
  updater_id                   String
  updater                      user                       @relation("InventoryTransactionUpdater", fields: [updater_id], references: [id])

  @@index([creator_id])
  @@index([updater_id])
  @@index([created_by_id])
  @@index([location_id])
  @@index([product_id])
  @@index([bin_id])
  @@index([inventory_transactionable_id])
  @@index([product_id, occurred_at])
}
