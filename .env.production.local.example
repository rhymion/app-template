# Vercel deployment configuration (used by scripts/vercel-env.sh / vercel-setup.sh /
# vercel-deploy.sh / vercel-teardown.sh).
# Copy this file to .env.production.local and fill in the actual values.
# Never commit .env.production.local (it is gitignored via .env* in .gitignore).

# ── Vercel project / auth ─────────────────────────────────
# Personal token from vercel.com/account/tokens.
# Used as an env var only — never pass via --token (would leak in process list).
VERCEL_TOKEN=
VERCEL_ORG_ID=team_dV6bZ5phXWZj0nuGdtinMzJQ
VERCEL_PROJECT_NAME=app-generator-sample

# ── Prisma Postgres — two-DB pattern (prod + shared staging) ──
# prod(1) + staging(1) = 2 total, well within Prisma Postgres Free tier (5 max).
# All preview deploys share PRISMA_DATABASE_URL_STAGING (see docs/vercel-automation-design.md §7).
# Issued via Prisma Console (https://console.prisma.io) → Accelerate.
PRISMA_DATABASE_URL_PROD=prisma+postgres://accelerate.prisma-data.net/?api_key=
PRISMA_DATABASE_URL_STAGING=prisma+postgres://accelerate.prisma-data.net/?api_key=

# ── Auth.js ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# generate-once-persist: auto-generated on first run and written back to .env.production.local — keep fixed thereafter
# Changing this invalidates all user sessions — must remain constant across deployments
AUTH_SECRET=
# Do not set AUTH_URL (use AUTH_TRUST_HOST=true instead)

# ── Upstash Redis (rate-limit, shared with GCP) ─────────────
# rediss:// URL issued via Upstash Console (https://console.upstash.com)
REDIS_URL=

# ── Google OAuth (optional) ─────────────────────────────────
# Only required if siteConfig enables the Google provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Vercel Blob (uploads — PD-3/PD-4, pending migration) ────
# Manual: Vercel Dashboard → Storage → Create Blob store. Cannot be automated.
BLOB_READ_WRITE_TOKEN=
